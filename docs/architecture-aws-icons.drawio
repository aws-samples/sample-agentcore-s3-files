          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n_e_eni" value="③ ENI attachment&lt;br&gt;network_mode = VPC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;dashed=1;strokeColor=#01A88D;labelBackgroundColor=#F5F5F5;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_managed" target="n_sg">
