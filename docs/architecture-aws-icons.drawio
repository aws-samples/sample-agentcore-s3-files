        <mxCell id="n_e_cli" value="① InvokeAgentRuntime&lt;br&gt;HTTPS 443 · SigV4 — over the internet, never into the VPC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#8C4FFF;labelBackgroundColor=#F5F5F5;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_cli" target="n_dp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
