          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n_e_nat" value="⑤ 443 egress" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#8C4FFF;labelBackgroundColor=#F5F5F5;fontSize=11;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_sg" target="n_nat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n_e_igw" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#8C4FFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_nat" target="n_igw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n_e_out" value="⑥ egress to regional endpoints&lt;br&gt;Gateway · Bedrock · Secrets Manager · ECR · GitLab" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#8C4FFF;labelBackgroundColor=#F5F5F5;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.95;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_igw" target="n_regional">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="n_note1" value="&lt;b&gt;Two planes, not one&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Inbound (invoke):&lt;/b&gt; ① ② — a public regional AWS API endpoint, SigV4/IAM. There is no inbound listener in your subnets and no path from CI into the VPC.&lt;br&gt;&lt;br&gt;&lt;b&gt;Outbound (workload):&lt;/b&gt; ③ ④ ⑤ ⑥ — the runtimes get ENIs in your private subnets. That is what makes the NFS mount possible, and what forces everything else out through NAT." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#FFF8E1;strokeColor=#D6B656;fontSize=11;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="920" width="320" height="280" as="geometry" />
        </mxCell>
        <mxCell id="n_note2" value="&lt;b&gt;Cost / hardening note&lt;/b&gt;&lt;br&gt;&lt;br&gt;Only NFS 2049 is VPC-internal. Gateway, Bedrock, Secrets Manager and ECR traffic all leaves via NAT and returns over the internet — NAT data processing charges apply per GB.&lt;br&gt;&lt;br&gt;Adding interface VPC endpoints for bedrock-agentcore, bedrock-runtime, secretsmanager and ecr.* would keep that traffic on the AWS network and cut NAT egress." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#E8F5E9;strokeColor=#4CAF50;fontSize=11;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="1240" width="320" height="260" as="geometry" />
        </mxCell>

        <mxCell id="n_legend" value="&lt;b&gt;Legend&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#8C4FFF&quot;&gt;━━&lt;/font&gt; network path over the internet (443)&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#7AA116&quot;&gt;━━&lt;/font&gt; NFS 2049, VPC-internal only&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#01A88D&quot;&gt;╍╍&lt;/font&gt; ENI attachment (not a data path)&amp;nbsp;&amp;nbsp;&amp;nbsp;① … ⑥ ordered steps&lt;br&gt;&lt;br&gt;Verified against terraform: modules/agentcore/main.tf:47-53 and modules/mcp/main.tf:207-213 (network_mode = VPC, private subnets) · modules/vpc/main.tf:16,75 (IGW + NAT) · modules/mcp/main.tf:27-75 (SG rules 2049 / 443 / 53) · src/shared/a2a_client.py:18,107 (regional endpoint + SigV4)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fillColor=#FFFFFF;strokeColor=#B1B7BE;fontSize=11;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="1440" width="1540" height="90" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
